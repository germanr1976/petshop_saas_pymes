// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  VENDEDOR
  CLIENTE
}

enum UserScope {
  PLATFORM
  TENANT
}

enum TenantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum SaleStatus {
  OPEN
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  MERCADOPAGO
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  RETURN
}

enum DocumentType {
  DNI
  CUIT
  CUIL
  PASSPORT
  OTHER
}

enum SourceType {
  SALE
  ORDER
  ADJUSTMENT
  RETURN
  MANUAL
}

model Tenant {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  status      TenantStatus @default(ACTIVE)
  email       String?
  phone       String?
  address     String?
  websiteUrl  String?
  logoUrl     String?
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime?    @db.Timestamptz(3)

  users         User[]
  categories    Category[]
  products      Product[]
  productImages ProductImage[]
  customerTenants CustomerTenant[]
  sales         Sale[]
  saleItems     SaleItem[]
  orders        Order[]
  orderItems    OrderItem[]
  stockMoves    StockMovement[]
  payments      Payment[]
  auditLogs     AuditLog[]
  tenantConfig  TenantConfig?

  @@index([status])
  @@index([createdAt])
  @@map("tenants")
}

model User {
  id           String     @id @default(cuid())
  tenantId     String?
  tenant       Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scope        UserScope  @default(TENANT)
  name         String
  email        String
  passwordHash String
  phone        String?
  role         Role       @default(CLIENTE)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?  @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)
  deletedAt    DateTime?  @db.Timestamptz(3)

  sales        Sale[]
  orders       Order[]
  stockMoves   StockMovement[]
  auditLogs    AuditLog[]

  @@unique([tenantId, email])
  @@index([tenantId, role])
  @@index([tenantId, status])
  @@index([email])
  @@map("users")
}

model Customer {
  id             String       @id @default(cuid())
  // Customers are global; their association to tenants is via CustomerTenant
  firstName      String
  lastName       String
  email          String?
  phone          String?
  documentNumber String?
  documentType   DocumentType?
  birthDate      DateTime?    @db.Date
  address        String?
  city           String?
  province       String?
  country        String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime?    @db.Timestamptz(3)

  sales    Sale[]
  orders   Order[]
  payments Payment[]

  customerTenants CustomerTenant[]

  @@unique([email])
  @@index([isActive])
  @@map("customers")
}

model CustomerTenant {
  id         String   @id @default(cuid())
  customerId String
  tenantId   String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@unique([tenantId, customerId])
  @@index([tenantId])
  @@index([customerId])
  @@map("customer_tenants")
}

model Category {
  id               String    @id @default(cuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String
  slug             String
  description      String?
  parentCategoryId String?
  parentCategory   Category? @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime? @db.Timestamptz(3)

  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@unique([tenantId, slug])
  @@index([tenantId, isActive])
  @@index([parentCategoryId])
  @@map("categories")
}

model Product {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId     String?
  category       Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sku            String
  name           String
  slug           String
  description    String?
  shortDescription String?
  price          Decimal       @db.Decimal(12, 2)
  cost           Decimal?      @db.Decimal(12, 2)
  stock          Int           @default(0)
  reorderPoint   Int?
  isActive       Boolean       @default(true)
  isFeatured     Boolean       @default(false)
  trackStock     Boolean       @default(true)
  weight         Decimal?      @db.Decimal(10, 3)
  dimensions     String?
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime?     @db.Timestamptz(3)
  status         ProductStatus @default(ACTIVE)

  productImages ProductImage[]
  saleItems     SaleItem[]
  orderItems    OrderItem[]
  stockMoves    StockMovement[]

  @@unique([tenantId, sku])
  @@unique([tenantId, slug])
  @@index([tenantId, isActive])
  @@index([tenantId, categoryId])
  @@index([tenantId, name])
  @@index([stock])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([productId, sortOrder])
  @@index([tenantId, productId])
  @@map("product_images")
}

model StockMovement {
  id        String            @id @default(cuid())
  tenantId  String
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId String
  product   Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  userId    String?
  user      User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      StockMovementType
  quantity  Int
  reason    String?
  sourceType SourceType?
  sourceId  String?
  notes     String?
  createdAt DateTime          @default(now()) @db.Timestamptz(3)

  @@index([tenantId, productId, createdAt])
  @@index([tenantId, type])
  @@index([sourceType, sourceId])
  @@map("stock_movements")
}

model Sale {
  id            String      @id @default(cuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  userId        String?
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  saleNumber    String
  status        SaleStatus  @default(OPEN)
  subtotal      Decimal     @db.Decimal(12, 2)
  discount      Decimal     @default(0) @db.Decimal(12, 2)
  total         Decimal     @db.Decimal(12, 2)
  paymentStatus PaymentStatus @default(PENDING)
  notes         String?
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @db.Timestamptz(3)
  closedAt      DateTime?   @db.Timestamptz(3)
  cancelledAt   DateTime?   @db.Timestamptz(3)

  items    SaleItem[]
  payments Payment[]

  @@unique([tenantId, saleNumber])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, customerId])
  @@map("sales")
}

model SaleItem {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  saleId        String
  sale          Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity      Int
  unitPrice     Decimal  @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  subtotal      Decimal  @db.Decimal(12, 2)
  total         Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([saleId])
  @@index([tenantId, productId])
  @@map("sale_items")
}

model Order {
  id            String      @id @default(cuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  userId        String?
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderNumber   String
  status        OrderStatus @default(PENDING)
  subtotal      Decimal     @db.Decimal(12, 2)
  discount      Decimal     @default(0) @db.Decimal(12, 2)
  shippingCost  Decimal     @default(0) @db.Decimal(12, 2)
  total         Decimal     @db.Decimal(12, 2)
  notes         String?
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @db.Timestamptz(3)
  paidAt        DateTime?   @db.Timestamptz(3)
  cancelledAt   DateTime?   @db.Timestamptz(3)
  deliveredAt   DateTime?   @db.Timestamptz(3)

  items    OrderItem[]
  payments Payment[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, createdAt])
  @@map("orders")
}

model OrderItem {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity      Int
  unitPrice     Decimal  @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  subtotal      Decimal  @db.Decimal(12, 2)
  total         Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([orderId])
  @@index([tenantId, productId])
  @@map("order_items")
}

model Payment {
  id               String        @id @default(cuid())
  tenantId         String
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  saleId           String?
  sale             Sale?         @relation(fields: [saleId], references: [id], onDelete: SetNull)
  orderId          String?
  order            Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customerId       String?
  customer         Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  paymentMethod    PaymentMethod
  paymentProvider  String?
  providerReference String?
  amount           Decimal       @db.Decimal(12, 2)
  currency         String        @default("ARS")
  status           PaymentStatus @default(PENDING)
  paidAt           DateTime?     @db.Timestamptz(3)
  refundedAt       DateTime?     @db.Timestamptz(3)
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(3)

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([providerReference])
  @@unique([tenantId, providerReference])
  @@map("payments")
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  entityType String
  entityId   String
  action     String
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

model TenantConfig {
  id                   String   @id @default(cuid())
  tenantId             String   @unique
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  timezone             String   @default("America/Argentina/Buenos_Aires")
  currency             String   @default("ARS")
  locale               String   @default("es-AR")
  autoConfirmOrders    Boolean  @default(false)
  lowStockThreshold    Int      @default(5)
  allowOnlineOrders    Boolean  @default(true)
  allowLocalSales      Boolean  @default(true)
  allowReturns         Boolean  @default(true)
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  @@index([tenantId])
  @@map("tenant_config")
}
